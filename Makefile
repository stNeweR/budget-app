SHELL := /bin/bash

POSTGRES_PORT ?= $(shell sed -n 's/^POSTGRES_PORT=//p' .env 2>/dev/null | tail -n1 | tr -d '"\r')
ifeq ($(strip $(POSTGRES_PORT)),)
POSTGRES_PORT := 5432
endif
export POSTGRES_PORT

DB_URL_LOCAL      ?= postgresql+asyncpg://family:family@localhost:$(POSTGRES_PORT)/family
TEST_DB_NAME      ?= family_test
TEST_DB_URL_LOCAL ?= postgresql+asyncpg://family:family@localhost:$(POSTGRES_PORT)/family_test

.DEFAULT_GOAL := help

## help: show this help
help:
	@echo "Доступные команды:"
	@grep -E '^## [a-z].*:' $(MAKEFILE_LIST) | sed 's/## //; s/:.*//' | sort | awk '{printf "  %-22s\n", $$1}'

## up: build and start postgres + migrations + backend + frontend
up:
	docker compose up --build -d

## down: stop containers and remove volumes
down:
	docker compose down -v

## logs: follow backend logs
logs:
	docker compose logs -f backend

## ps: show container status
ps:
	docker compose ps

## install: install python dependencies (dev included)
install:
	uv sync

## migrate-up: apply migrations locally
migrate-up:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run alembic upgrade head

## migrate-down: roll back the last migration locally
migrate-down:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run alembic downgrade -1

## migrate-status: show local migration status
migrate-status:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run alembic current

## revision: create a new autogenerated migration (make revision m="message")
revision:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run alembic revision --autogenerate -m "$(m)"

## seed: insert demo data locally
seed:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run python -m app.seed

## seed-reset: wipe and re-insert demo data locally
seed-reset:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run python -m app.seed --reset

## seed-docker: wipe and re-insert demo data via the backend image
seed-docker:
	docker compose run --rm --entrypoint python backend -m app.seed --reset

## run: run the backend locally
run:
	DATABASE_URL="$(DB_URL_LOCAL)" uv run uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload

## web-dev: run the Vite dev server (proxies /api to :8080)
web-dev:
	cd frontend && npm run dev

## test: run tests against the local test database
test:
	TEST_DATABASE_URL="$(TEST_DB_URL_LOCAL)" uv run pytest -q

## test-db: create and migrate the test database in the compose postgres
test-db:
	docker compose exec -T postgres psql -U family -d family -c "DROP DATABASE IF EXISTS $(TEST_DB_NAME);"
	docker compose exec -T postgres psql -U family -d family -c "CREATE DATABASE $(TEST_DB_NAME);"

## lint: run ruff
lint:
	uv run ruff check app tests
