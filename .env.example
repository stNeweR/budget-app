# --- Database ---------------------------------------------------------------
# Inside docker compose the host is "postgres"; for local runs use "localhost".
DATABASE_URL=postgresql+asyncpg://family:family@postgres:5432/family
POSTGRES_USER=family
POSTGRES_PASSWORD=family
POSTGRES_DB=family
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_CODE_TTL_SECONDS=300
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
PANEL_URL=http://localhost:5173

# --- LLM (OpenRouter, OpenAI-compatible) ------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-key
LLM_MODEL=openrouter/free
LLM_HTTP_REFERER=
LLM_TITLE=Family Budget
LLM_TIMEOUT_SECONDS=60

# --- Telegram bot -----------------------------------------------------------
# With only TELEGRAM_BOT_TOKEN the bot uses long polling (no public URL needed).
# Set TELEGRAM_WEBHOOK_URL (public HTTPS base URL) to switch to webhook mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org
